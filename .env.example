# ========================================================
# Google Wallet Integration Configuration
# ========================================================

# Server Port
PORT=3000

# Base URL (used for JWT origins and local links)
APP_BASE_URL=http://localhost:3000

# Google Wallet Issuer ID
# Found in Google Pay & Wallet Console: https://pay.google.com/business/console
# Format: 19-digit numerical string (e.g. 3388000000022xxxxxx)
GOOGLE_WALLET_ISSUER_ID=

# Pass Class ID (alphanumeric string, e.g. digital_balance_pass)
GOOGLE_WALLET_CLASS_ID=digital_balance_pass

# Issuer display name shown on passes
GOOGLE_WALLET_ISSUER_NAME=Google Wallet Live Demo

# Authentication Option A: Path to Service Account JSON file
# Place your key at credentials/service-account.json or specify absolute path
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Authentication Option B: Direct Environment Variables (Useful for Cloud Hosting)
# GOOGLE_CLIENT_EMAIL=google-wallet-issuer@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Authentication Option C: Raw JSON string of the entire service account
# GOOGLE_SERVICE_ACCOUNT_JSON=
